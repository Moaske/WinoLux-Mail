<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wino.Mail.Linux</RootNamespace>
    <AssemblyName>WinoLux</AssemblyName>
    <WinoGtkProject>true</WinoGtkProject>
    <!-- A downloaded build runs without a separately installed .NET runtime. An explicit RuntimeIdentifier
         (for example linux-arm64) wins. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Set only on the head: a global PublishAot would also reach the netstandard2.0 source generator. -->
    <PublishAot Condition="'$(WinoLinuxNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <!-- The shared thumbnail service sizes sender pictures with SkiaSharp, whose package carries no Linux library. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wino.Platform.Linux\Wino.Platform.Linux.csproj" />
    <ProjectReference Include="..\Wino.Core\Wino.Core.csproj" />
    <ProjectReference Include="..\Wino.Mail.ViewModels\Wino.Mail.ViewModels.csproj" />
    <ProjectReference Include="..\..\controls\Wino.Presentation.Core\Wino.Presentation.Core.csproj" />
    <ProjectReference Include="..\..\controls\Wino.Editor.Gtk\Wino.Editor.Gtk.csproj" />
  </ItemGroup>

  <!-- Files the shared services read as packaged resources (LinuxPaths.PackagedResourceRoot, next to the program):
       provider logos and the What's New release notes, as the Android head ships them. -->
  <ItemGroup>
    <Content Include="../Wino.Mail.WinUI/Assets/Providers/*.png" Link="PackagedResources/Assets/Providers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The Material Rounded WinoIcons font (decision L1), registered with fontconfig by WinoIcons.Register. -->
    <Content Include="../../icons/fonts/WinoIconsMaterialRounded.ttf" Link="PackagedResources/Fonts/WinoIcons.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Wino.Mail.WinUI/Assets/WhatsNew/*.json;../Wino.Mail.WinUI/Assets/WhatsNew/*.png" Link="PackagedResources/Assets/WhatsNew/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
