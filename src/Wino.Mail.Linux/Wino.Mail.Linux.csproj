<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wino.Mail.Linux</RootNamespace>
    <AssemblyName>WinoLux</AssemblyName>
    <WinoGtkProject>true</WinoGtkProject>
    <!-- A downloaded build runs without a separately installed .NET runtime. An explicit RuntimeIdentifier
         (for example linux-arm64) wins. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Set only on the head: a global PublishAot would also reach the netstandard2.0 source generator. -->
    <PublishAot Condition="'$(WinoLinuxNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wino.Core.Domain\Wino.Core.Domain.csproj" />
  </ItemGroup>
</Project>
